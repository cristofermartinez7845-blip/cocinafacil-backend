                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es la categoría creada\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"categoria_id\"))); });"
                ]
