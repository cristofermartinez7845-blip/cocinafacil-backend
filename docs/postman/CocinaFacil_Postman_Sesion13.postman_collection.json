    {
      "name": "A. Categorías",
      "item": [
        {
          "name": "1. Crear categoría (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.test(\"Devuelve id y nombre\", function () { pm.expect(d).to.have.property(\"id\"); pm.expect(d).to.have.property(\"nombre\"); });",
                  "pm.collectionVariables.set(\"categoria_id\", d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cat Postman {{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
