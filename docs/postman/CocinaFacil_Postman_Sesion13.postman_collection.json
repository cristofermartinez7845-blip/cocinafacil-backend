    {
      "name": "C. Recetas (incluye concurrencia)",
      "item": [
        {
          "name": "1. Crear receta con ingrediente (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.test(\"Empieza en version 1\", function () { pm.expect(d.version).to.eql(1); });",
                  "pm.test(\"Trae el ingrediente\", function () { pm.expect(d.ingredientes).to.have.length(1); });",
                  "pm.collectionVariables.set(\"receta_id\", d.id);",
                  "pm.collectionVariables.set(\"receta_version\", d.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recetas/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recetas",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Receta Postman\",\n  \"descripcion\": \"Creada desde Postman\",\n  \"instrucciones\": \"Mezclar todo y cocinar.\",\n  \"tiempo_preparacion\": 20,\n  \"porciones\": 2,\n  \"categoria\": {{categoria_id}},\n  \"ingredientes\": [\n    { \"ingrediente\": {{ingrediente_id}}, \"cantidad\": 150, \"unidad\": \"g\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
